# Kuroco API base, e.g. https://your-project.g.kuroco.app
NUXT_PUBLIC_KUROCO_API_BASE=https://meroj.g.kuroco.app

# --- API structures -------------------------------------------------------
# There is NO API token in this app. The site is statically generated, so it has
# no server to keep a secret in — anything shipped here is readable by every
# visitor. Authentication is the member's session cookie, set by signing in.
#
# Consequence: every structure below MUST be in `cookie` security mode, and each
# endpoint the frontend calls must exist on one of them.
#
#   7 = "Omnix User Authentication Endpoints" (security: cookie)  <- use this
#   6 = "Dota2: Endpoints" (security: static_token, hosts the MCP server)
#       Deliberately NOT called from the browser: it would require shipping a
#       token, and its security mode cannot change without affecting MCP.
NUXT_PUBLIC_KUROCO_API_ID=7
NUXT_PUBLIC_KUROCO_AUTH_API_ID=7
NUXT_PUBLIC_KUROCO_NOTES_API_ID=7

# Path (relative to /rcms-api/{id}/) that answers Omnix queries.
# This endpoint currently exists only on api 6 — it must be added to the cookie
# structure above before chat will work from the browser.
NUXT_PUBLIC_OMNIX_ENDPOINT=chat_contents_search

# --- Auth + notes endpoint paths -----------------------------------------
# Model methods these map to:
#   auth/login   -> Login::login_challenge
#   auth/logout  -> Login::logout
#   auth/profile -> Login::profile
#   notes/*      -> Topics::list / insert / update / delete on the notes group
NUXT_PUBLIC_AUTH_LOGIN_PATH=auth/login
NUXT_PUBLIC_AUTH_LOGOUT_PATH=auth/logout
NUXT_PUBLIC_AUTH_PROFILE_PATH=auth/profile
NUXT_PUBLIC_NOTES_LIST_PATH=notes/list
NUXT_PUBLIC_NOTES_CREATE_PATH=notes/create
NUXT_PUBLIC_NOTES_UPDATE_PATH=notes/update
NUXT_PUBLIC_NOTES_DELETE_PATH=notes/delete

# The old KUROCO_ACCESS_TOKEN is gone. It was read by server/api/omnix.post.ts,
# which never ran in production: the site deploys as a static bundle (only
# .output/public), so there was no Nitro server to host that route.
