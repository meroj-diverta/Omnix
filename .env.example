# Kuroco API base, e.g. https://your-project.g.kuroco.app
NUXT_PUBLIC_KUROCO_API_BASE=https://meroj.g.kuroco.app

# Kuroco API ID (the numeric segment in /rcms-api/{id}/...)
NUXT_PUBLIC_KUROCO_API_ID=6

# Path (relative to /rcms-api/{id}/) that answers oracle queries
NUXT_PUBLIC_ORACLE_ENDPOINT=chat_contents_search

# Secret Kuroco API access token (X-RCMS-API-ACCESS-TOKEN header).
# Server-side only — never exposed to the browser. Do not prefix with NUXT_PUBLIC_.
KUROCO_ACCESS_TOKEN=
